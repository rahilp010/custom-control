{
  "name": "@rahilp010/custom-control",
  "version": "1.1.1",
  "description": "React Custom Controls - Reusable, accessible, and themeable React form controls and UI component library. Includes custom select picker, date picker, inputs, toggle, modal, combobox, and more with dark/light mode.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahilp010/custom-control.git"
  },
  "homepage": "https://github.com/rahilp010/custom-control#readme",
  "bugs": {
    "url": "https://github.com/rahilp010/custom-control/issues"
  },
  "keywords": [
    "custom-controls",
    "custom-control",
    "custom controls",
    "react-custom-controls",
    "react custom control",
    "react-form-controls",
    "form-controls",
    "react-controls",
    "react",
    "ui-components",
    "reusable-components",
    "rsuite",
    "react-suite",
    "selectpicker",
    "select-picker",
    "datepicker",
    "date-picker",
    "daterangepicker",
    "date-range",
    "timepicker",
    "time-picker",
    "combobox",
    "autocomplete",
    "otp",
    "otp-input",
    "input-number",
    "number-input",
    "button",
    "input",
    "textbox",
    "textarea",
    "password",
    "password-input",
    "search",
    "search-input",
    "toggle",
    "switch",
    "checkbox",
    "radio",
    "radiogroup",
    "slider",
    "color-picker",
    "modal",
    "dialog",
    "tooltip",
    "whisper",
    "alert",
    "toast",
    "notification",
    "progress",
    "skeleton",
    "form-field",
    "uploader",
    "file-upload",
    "dark-mode",
    "light-mode",
    "theme",
    "themeable",
    "tailwind",
    "framer-motion",
    "accessible",
    "a11y"
  ],
  "license": "MIT",
  "author": "Rahil Patel",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/custom-control.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && node scripts/postbuild.mjs",
    "size": "size-limit",
    "prepublishOnly": "npm run build && npm run size"
  },
  "size-limit": [
    {
      "name": "ESM bundle (gzip)",
      "path": "dist/index.js",
      "gzip": true,
      "limit": "20 kB"
    },
    {
      "name": "Stylesheet (gzip)",
      "path": "dist/custom-control.css",
      "gzip": true,
      "limit": "6 kB"
    }
  ],
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "framer-motion": "^11.11.17"
  },
  "devDependencies": {
    "@size-limit/file": "^14.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^14.3.0",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}